# ホワイトリスト方式: すべて無視し、`!` で許可したものだけを追跡する
*

!/.github/
!/.github/**/
!/.github/CODEOWNERS
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/bug_report.yaml
!/.github/ISSUE_TEMPLATE/feature_request.yaml
!/.github/workflows/ci.yaml

!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/CLAUDE.md
!/LICENSE
!/mise.toml
!/mise.lock
# mise.lock が npm: backend のツールの依存の lock をこの下のパスと digest で参照する
!/.mise/
!/.mise/locks/
!/.mise/locks/**
# mise.local.toml (追跡しない) の lock の sidecar は追跡しない
/.mise/locks/mise.local/
!/fnox.toml
!/.pre-commit-config.yaml
!/commitlint.config.mjs
!/dprint.json
!/typos.toml
!/renovate.json

!/pyproject.toml
!/.python-version
!/uv.lock
!/Dockerfile
!/.hadolint.yaml
!/.dockerignore
!/src/
!/src/**
!/tests/
!/tests/**

# `!/src/**` `!/tests/**` で広く許可した配下にも secret・生成物・editor artifact は入れない
# (ホワイトリスト化前の .gitignore と同じパターン)
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
.env
.env.*
*.pem
*.key
*key.json
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log
tmp/
.tmp/
*.bak
CLAUDE.local.md
.claude/settings.local.json
